map $http_x_otus_check $otus_marker {
    default "";
    "~^[a-f0-9]{32}$" $http_x_otus_check;
}

log_format otus escape=json
    '{"event":"http_access","method":"$request_method","status":$status,"marker":"$otus_marker"}';

server {
    listen 127.0.0.1:{{ wordpress_port }};
    server_name localhost;
    root /var/www/otus;
    index index.php;
    access_log /var/log/nginx/otus-access.log otus;

    location / { try_files $uri $uri/ /index.php?$args; }
    location = /wp-config.php { deny all; }
    location ~ /\. { deny all; }
    location ~ ^/wp-content/uploads/.*\.php$ { deny all; }
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
    }
}

server {
    listen 127.0.0.1:{{ kibana_port }};
    server_name localhost;
    access_log off;

    location / {
        proxy_pass http://{{ logs_address }}:{{ kibana_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
    }
}
